{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build library system",
            "type": "shell",
            "command": "O:\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-g",
                "-Iinclude",
                "src/Book.cpp",
                "src/BorrowRecord.cpp",
                "src/BorrowRule.cpp",
                "src/CsvUtils.cpp",
                "src/DateUtils.cpp",
                "src/Library.cpp",
                "src/Reader.cpp",
                "src/main.cpp",
                "-o",
                "library_system.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Compile all source files into library_system.exe"
        },
        {
            "label": "test library system",
            "type": "shell",
            "command": "O:\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-g",
                "-Iinclude",
                "src/Book.cpp",
                "src/BorrowRecord.cpp",
                "src/BorrowRule.cpp",
                "src/CsvUtils.cpp",
                "src/DateUtils.cpp",
                "src/Library.cpp",
                "src/Reader.cpp",
                "tests/test_library.cpp",
                "-o",
                "tests/test_library.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compile the assertion tests"
        },
        {
            "label": "run library system",
            "type": "process",
            "command": "${workspaceFolder}\\library_system.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "build library system",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "O:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}